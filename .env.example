# --- Django (en producción NUNCA subir el .env real a git)
DJANGO_SECRET_KEY=genera-una-clave-larga-con: python -c "import secrets;print(secrets.token_urlsafe(60))"
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.mitienda.com
CSRF_TRUSTED_ORIGINS=https://api.mitienda.com
CORS_ALLOWED_ORIGINS=https://app.mitienda.com
ADMIN_URL=panel-8f3k2x/

# --- Supabase: Project Settings > Database > Connection string (URI)
# Conexión directa (5432) o pooler "session". Si usas el pooler de transacción (6543) activa DB_POOLER_TRANSACCION=1
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TUPROYECTO.supabase.co:5432/postgres
DB_POOLER_TRANSACCION=0

# --- Supabase Storage (imágenes): Storage > S3 Connection. Bucket PRIVADO.
SUPABASE_S3_BUCKET=productos
SUPABASE_S3_ENDPOINT=https://TUPROYECTO.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=us-east-1

# --- Reglas del negocio
STOCK_NEGATIVO_PERMITIDO=1

# --- Opcional: caché compartida entre varios workers (límites de peticiones consistentes)
# REDIS_URL=redis://localhost:6379/0
